@host = http://localhost:5045

# @name login
POST {{host}}/api/auth/login
Content-Type: application/json

{ "username": "admin", "password": "Admin@123" }

###

@token = {{login.response.body.token}}

GET {{host}}/api/dashboard
Authorization: Bearer {{token}}

###

# DevExtreme load options: skip/take/sort/filter are JSON in the query string.
GET {{host}}/api/customers?skip=0&take=5&requireTotalCount=true&sort=[{"selector":"name","desc":false}]&filter=["status","=",1]
Authorization: Bearer {{token}}

###
